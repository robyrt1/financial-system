{
  "name": "financial-system",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "back:dev": "docker compose --profile dev -f docker-compose.dev.yml up -d --build",
    "docker:networks": "bash scripts/create-networks.sh",
    "infra:up": "docker compose -f docker-compose.infra.yml up -d",
    "deps:up": "docker compose -f docker-compose.deps.yml up -d",
    "infra:down": "docker compose -f docker-compose.infra.yml down",
    "deps:down": "docker compose -profile dev -f docker-compose.deps.yml down"
  },
  "devDependencies": {
    "@financial-system/eslint-config": "workspace:*",
    "@financial-system/shared-errors": "workspace:*",
    "@financial-system/shared-services": "workspace:*",
    "@financial-system/ts-config": "workspace:*",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3"
  }
}
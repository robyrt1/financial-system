{
  "name": "financial-system",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "back:dev": "docker compose --profile dev -f docker-compose.dev.yml up -d --build",
    "docker:networks": "bash scripts/create-networks.sh",
    "infra:up": "docker compose -f docker-compose.infra.yml up -d",
    "deps:up": "docker compose -f docker-compose.deps.yml up -d",
    "back:down": "docker compose -f docker-compose.dev.yml down",
    "infra:down": "docker compose -f docker-compose.infra.yml down",
    "deps:down": "docker compose -profile dev -f docker-compose.deps.yml down",
    "test:load:k6": "k6 run scripts/k6-load-test.js",
    "test:load:autocannon": "node scripts/autocannon-load-test.js",
    "prepare": "node -e \"if (process.env.NODE_ENV !== 'production' && !process.env.CI) { require('child_process').spawnSync('husky', { stdio: 'inherit' }) }\""
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "@financial-system/eslint-config": "workspace:*",
    "@financial-system/shared-errors": "workspace:*",
    "@financial-system/shared-services": "workspace:*",
    "@financial-system/ts-config": "workspace:*",
    "autocannon": "^8.0.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.67.0"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
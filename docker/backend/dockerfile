FROM node:24-alpine as builder
WORKDIR /app

ARG path_service_to_build

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

COPY packages/eslint-config ./packages/eslint-config
COPY packages/ts-config ./packages/ts-config
COPY packages/shared-errors ./packages/shared-errors
COPY packages/shared-services ./packages/shared-services

# Copy the app source code
COPY apps/backend/${path_service_to_build} ./apps/backend/${path_service_to_build}

RUN pnpm install --frozen-lockfile --ignore-scripts

RUN PKG_NAME=$(node -p "require('./apps/backend/${path_service_to_build}/package.json').name") && \
    pnpm --filter "...$PKG_NAME" build

# Deploy the application to a flat production-ready directory
RUN PKG_NAME=$(node -p "require('./apps/backend/${path_service_to_build}/package.json').name") && \
    pnpm --filter "$PKG_NAME" --prod --legacy deploy /prod --ignore-scripts

FROM node:24-alpine as runtime

# Copy workspace packages to satisfy legacy symlink resolution
COPY --from=builder /app/packages /packages

WORKDIR /app

ARG port=3000
ENV NODE_ENV=production
ENV PORT=${port}

COPY --from=builder /prod ./

EXPOSE ${port}

CMD ["npm", "run", "start:prod"]